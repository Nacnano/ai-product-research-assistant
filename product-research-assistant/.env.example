# ============================================
# AI Product Research Assistant - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual API keys

# ============================================
# Project Configuration
# ============================================
PROJECT_NAME="AI Product Research Assistant"

# ============================================
# LLM Provider Configuration (REQUIRED)
# ============================================
# Choose your LLM provider: "openai" or "google"
LLM_PROVIDER="google"

# OpenAI Configuration (if using LLM_PROVIDER=openai)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Google Gemini Configuration (if using LLM_PROVIDER=google)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=""

# ============================================
# Web Search API Keys (OPTIONAL)
# ============================================
# If not provided, the system will use mock search data
# At least one of these is recommended for real market intelligence

# Serper API (Google Search) - https://serper.dev/
SERPER_API_KEY=""

# Tavily API (Web Search) - https://tavily.com/
TAVILY_API_KEY=""

# ============================================
# Data Configuration (OPTIONAL)
# ============================================
# Override default paths if needed (uncomment to use)
# DATA_PATH=./data/products_catalog.csv
# CHROMA_PERSIST_DIRECTORY=./data/chroma_db
